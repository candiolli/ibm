[Unit]
Description=Bot do Telegram do acervo de louvor (Claude Code)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/ibm-bot/env
Environment=PATH=%h/.nvm/versions/node/v22.14.0/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 %h/workspace/ibm/bot/bot.py
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
